<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="Theme.DmGym" parent="@android:style/Theme.Material.NoActionBar" />

  <!-- Écran de démarrage : fond brique et d20, affiché jusqu'à la lecture de la palette (D53). -->
  <style name="Theme.DmGym.Starting" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
    <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    <item name="postSplashScreenTheme">@style/Theme.DmGym</item>
  </style>

  <!-- Écran de démarrage par palette (Android 13+, SplashScreen.setSplashScreenTheme) : fond de la palette,
       d20 sur pastille brique pour rester lisible sur les fonds clairs comme sombres. -->
  <style name="Theme.DmGym.Splash" parent="Theme.SplashScreen">
    <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    <item name="windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
    <item name="postSplashScreenTheme">@style/Theme.DmGym</item>
  </style>
  <style name="Theme.DmGym.Splash.ParchmentLight" parent="Theme.DmGym.Splash">
    <item name="windowSplashScreenBackground">@color/splash_parchment_light</item>
  </style>
  <style name="Theme.DmGym.Splash.ParchmentDark" parent="Theme.DmGym.Splash">
    <item name="windowSplashScreenBackground">@color/splash_parchment_dark</item>
  </style>
  <style name="Theme.DmGym.Splash.ForestLight" parent="Theme.DmGym.Splash">
    <item name="windowSplashScreenBackground">@color/splash_forest_light</item>
  </style>
  <style name="Theme.DmGym.Splash.ForestDark" parent="Theme.DmGym.Splash">
    <item name="windowSplashScreenBackground">@color/splash_forest_dark</item>
  </style>
  <style name="Theme.DmGym.Splash.NightLight" parent="Theme.DmGym.Splash">
    <item name="windowSplashScreenBackground">@color/splash_night_light</item>
  </style>
  <style name="Theme.DmGym.Splash.NightDark" parent="Theme.DmGym.Splash">
    <item name="windowSplashScreenBackground">@color/splash_night_dark</item>
  </style>
  <style name="Theme.DmGym.Splash.MistLight" parent="Theme.DmGym.Splash">
    <item name="windowSplashScreenBackground">@color/splash_mist_light</item>
  </style>
  <style name="Theme.DmGym.Splash.MistDark" parent="Theme.DmGym.Splash">
    <item name="windowSplashScreenBackground">@color/splash_mist_dark</item>
  </style>
</resources>
