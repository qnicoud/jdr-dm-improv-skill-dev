  <!-- Status Numbers (L10) -->
  <string name="status_instructions">Joue le PNJ à voix haute, comme à ta table. Montre son statut par le comportement uniquement, jamais en le disant.</string>
  <string name="status_reminder">Le statut n’est pas le rang social : c’est la façon dont le personnage s’attend à être traité.\nStatut haut : contrôle la conversation, regard direct, suppose la coopération.\nStatut bas : hésite, se coupe, évite le regard.</string>
  <string name="status_option_counter">Contre-stéréotype : statut opposé au rang du rôle</string>
  <string name="status_option_counter_help">Ton PNJ prend un statut à l’opposé de ce que son rôle laisse attendre : un prince humble, un serviteur qui domine. Casse le cliché.</string>
  <string name="status_option_shift">Bascule en cours de scène</string>
  <string name="status_option_shift_help">À mi-scène, un événement change la situation : ton PNJ doit changer de statut sans prévenir. Entraîne ta souplesse.</string>
  <string name="status_scene_done">Scène terminée</string>
  <string name="status_notes_label">Notes (facultatif)</string>
  <string name="status_notes_hint">Ce que tu as remarqué, ce que tu referais</string>
  <string name="status_rubric_readable">Mon statut se lisait-il sans mots ?</string>
  <string name="status_rubric_cliche">Ai-je évité le cliché ?</string>

  <!-- Decision Point Drill (L10) -->
  <string name="decision_point_instructions">Mets ta vidéo en pause quand un joueur surprend le MJ, puis lance le chrono : 30 secondes pour écrire 3 réponses possibles. Entraîne-toi à ce que ta première idée soit meilleure.</string>
